@page "/cardswithpictures"
@inject EnglishApp.Services.PictureService PictureService

<PageTitle>Cards with Pictures</PageTitle>

<h1>Cards with Pictures</h1>

@if (SelectedCategory == null)
{
    <PictureCategorySelector OnCategoryChanged="OnCategoryChanged" />
}
else
{
    <div class="card-display-board">
        @foreach (var pictureUrl in PicturesInSelectedCategory)
        {
            <div class="picture-card">
                <img src="@pictureUrl" alt="Category Image" />
            </div>
        }
    </div>
    <button class="btn btn-primary mt-3" @onclick="ResetSelection">Choose Another Category</button>
}

@code {
    private string SelectedCategory { get; set; }
    private List<string> PicturesInSelectedCategory { get; set; }

    private void OnCategoryChanged(string category)
    {
        SelectedCategory = category;
        PicturesInSelectedCategory = PictureService.GetPictures(SelectedCategory).ToList();
    }

    private void ResetSelection()
    {
        SelectedCategory = null;
        PicturesInSelectedCategory = null;
    }
}