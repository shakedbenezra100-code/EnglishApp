@page "/games"
@inject NavigationManager NavigationManager

<h3>Choose a Game</h3>

<div class="games-container">
    <div class="game-card" @onclick='() => SelectGame("wordmemory")'>
        <div class="game-icon">🧠</div>
        <h4>Memory Game</h4>
        <p>Match words with pictures</p>
    </div>

    <div class="game-card" @onclick='() => SelectGame("wordcards")'>
        <div class="game-icon">🎴</div>
        <h4>Flip Cards</h4>
        <p>Flip cards to practice words</p>
    </div>
</div>

@code {
    private void SelectGame(string gameType)
    {
        if (gameType == "wordmemory")
        {
            NavigationManager.NavigateTo($"/wordmemorygame");
        }
        else if (gameType == "wordcards")
        {
            NavigationManager.NavigateTo($"/combinedgame");
        }
    }
}