@page "/games"

<PageTitle>Games</PageTitle>

<h1>Choose a Game</h1>

<div class="game-selection-container">
    <div class="game-cube" @onclick='() => NavigateToGame("memory")'>
        <h2>Memory Game</h2>
        <p>Match the pairs of pictures.</p>
    </div>


</div>

@code {
    [Inject] 
    public NavigationManager NavigationManager { get; set; }

    private void NavigateToGame(string gameType)
    {
        NavigationManager.NavigateTo($"/tempcombinedgame");
    }
}