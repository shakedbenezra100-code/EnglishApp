@page "/games"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="container my-5" dir="rtl">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-dark">משחקים</h1>
        <div class="row justify-content-center mt-4">
            <div class="col-12 col-md-8 col-lg-6">
                <select id="categorySelect" class="form-select rounded-pill shadow-sm text-center p-3 fs-5" @onchange="OnCategorySelected">
                    <option value="">בחר קטגוריה כדי להתחיל לשחק</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category" selected="@(SelectedCategory == category)">@category</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="row g-4 justify-content-center @(string.IsNullOrEmpty(SelectedCategory) ? "opacity-50" : "")" 
         style="@(string.IsNullOrEmpty(SelectedCategory) ? "pointer-events: none; user-select: none;" : "")" dir="ltr">
    

        @foreach (var game in GameList)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 text-center shadow-sm p-4 border-1">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="display-5 mb-3">@game.Icon</div>
                            <h3 class="card-title h4 fw-bold text-secondary mb-3">@game.Name</h3>
                        </div>
                        <button class="btn btn-primary btn-lg rounded-pill w-100 mt-3" 
                                disabled="@string.IsNullOrEmpty(SelectedCategory)"
                                @onclick="() => StartGame(game.UrlPath)">
                            התחל לשחק
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string SelectedCategory { get; set; } = string.Empty;


    private List<string> Categories = new List<string>
    {
        "מאכלים",
        "צבעים",
        "חפצים",
        "חיות",
        "בגדים",
        "גוף האדם",
        "תחבורה",
        "משפחה",
        "מספרים",
        "פירות וירקות"
    };
    public class GameItem
    { 

        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string UrlPath { get; set; } = string.Empty;
    }

    private List<GameItem> GameList = new List<GameItem>
    {
        new GameItem { Name = "מה חסר", Icon = "🤷‍♀️", UrlPath = "what-is-missing" },
        new GameItem { Name = "כרטיסיות", Icon = "🃏", UrlPath = "flashcards" },
        new GameItem { Name = "משחק הזיכרון", Icon = "🧠", UrlPath = "memorygame" }
    };

    // מתודה חדשה שמטפלת בשינוי הקטגוריה ומאלצת את ה-UI להתרענן ולפתוח את הכפתורים
    private void OnCategorySelected(ChangeEventArgs e)
    {
        SelectedCategory = e.Value?.ToString() ?? string.Empty;
        StateHasChanged(); 
    }

    private void StartGame(string gameUrl)
    {
        if (string.IsNullOrEmpty(SelectedCategory)) return;

        string categoryEnglishValue = SelectedCategory switch
        {
            "מאכלים" => "foods",
            "צבעים" => "colors",
            "חפצים" => "stuff",
            "חיות" => "animals",
            "בגדים" => "clothes",
            "גוף האדם" => "body",
            "תחבורה" => "traffic",
            "משפחה" => "family",
            "מספרים" => "numbers",
            "פירות וירקות" => "fruitesAndVegtebales",
        };

        Navigation.NavigateTo($"/{gameUrl}/{categoryEnglishValue}");
    }
}