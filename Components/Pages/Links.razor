<style>
    /* הגדרת כיוון הטקסט לימין וגופן מתאים */
    .links-container {
        direction: rtl;
        text-align: right;
        font-family: sans-serif;
        padding: 20px;
    }

    /* מרכוז הטבלה בעמוד */
    .table-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    /* עיצוב בסיסי ונקי לטבלה */
    .custom-table {
        border-collapse: collapse;
        width: 60%; /* משנה את רוחב הטבלה לפי הצורך */
        min-width: 300px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .custom-table th, .custom-table td {
        border: 1px solid #dddddd;
        padding: 12px;
        text-align: right; /* יישור הטקסט בתוך תאי הטבלה לימין */
    }

    /* צבע רקע לכותרת הטבלה */
    .custom-table th {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    /* אפקט שורות מתחלפות (אופציונלי) */
    .custom-table tr:nth-child(even) {
        background-color: #f9f9f9;
    }
</style>