@page "/links"

<PageTitle>Links</PageTitle>

<div class="links-container">
    <h1 style="text-align: center;">קישורים</h1>

    <div class="table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>עמודה 1</th>
                    <th>עמודה 2</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>תוכן שורה 1</td>
                    <td>תוכן שורה 1</td>
                </tr>
                <tr>
                    <td>תוכן שורה 2</td>
                    <td>תוכן שורה 2</td>
                </tr>
                <tr>
                    <td>תוכן שורה 3</td>
                    <td>תוכן שורה 3</td>
                </tr>
                <tr>
                    <td>תוכן שורה 4</td>
                    <td>תוכן שורה 4</td>
                </tr>
                <tr>
                    <td>תוכן שורה 5</td>
                    <td>תוכן שורה 5</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    /* הגדרת כיוון הטקסט לימין וגופן מתאים */
    .links-container {
        direction: rtl;
        text-align: right;
        font-family: sans-serif;
        padding: 20px;
    }

    /* מרכוז הטבלה בעמוד */
    .table-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    /* עיצוב בסיסי ונקי לטבלה */
    .custom-table {
        border-collapse: collapse;
        width: 60%; /* משנה את רוחב הטבלה לפי הצורך */
        min-width: 300px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .custom-table th, .custom-table td {
        border: 1px solid #dddddd;
        padding: 12px;
        text-align: right; /* יישור הטקסט בתוך תאי הטבלה לימין */
    }

    /* צבע רקע לכותרת הטבלה */
    .custom-table th {
        background-color: #f4f4f4;
        font-weight: bold;
    }

    /* אפקט שורות מתחלפות (אופציונלי) */
    .custom-table tr:nth-child(even) {
        background-color: #f9f9f9;
    }
</style>