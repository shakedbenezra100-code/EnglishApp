@page "/memorygame/{CategoryName}"
@rendermode InteractiveServer
@inject EnglishApp.Services.PictureService PictureService

<PageTitle>Memory Game</PageTitle>

<h1>Memory Game - @CategoryName</h1>

<div class="memory-game-board" style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 20px;">
    @if (Cards != null && Cards.Count > 0)
    {
        @foreach (var card in Cards)
        {
            <div class="memory-card @(card.IsFlipped ? "flipped" : "") @(card.IsMatched ? "matched" : "")" 
                 @onclick="(() => FlipCard(card))" 
                 style="width: 120px; height: 120px; cursor: pointer;">
                <div class="card-inner" style="width: 100%; height: 100%;">
                    
                    @if (card.IsFlipped || card.IsMatched)
                    {
                        <div class="card-front" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border: 2px solid #ccc; border-radius: 8px; background-color: white;">
                            <img src="@card.PictureUrl" alt="Card Image" style="max-width: 90%; max-height: 90%; object-fit: contain;" />
                        </div>
                    }
                    else
                    {
                        <div class="card-back" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #007bff; color: white; font-size: 2rem; font-weight: bold; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                            ?
                        </div>
                    }
                    
                </div>
            </div>
        }
    }
    else
    {
        <p>Loading cards...</p>
    }
</div>

<button class="btn btn-primary mt-3" @onclick="ResetGame">Reset Memory Game</button>

@code {
    [Parameter]
    public string CategoryName { get; set; }

    private List<MemoryCard> Cards { get; set; }
    private List<MemoryCard> FlippedCards { get; set; }
    private int MatchedPairs { get; set; }

    protected override void OnInitialized()
    {
        FlippedCards = new List<MemoryCard>();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(CategoryName))
        {
            InitializeGame();
        }
    }

    private void InitializeGame()
{
    // שימוש בשם הקטגוריה באותיות קטנות (colors) כדי להתאים לשירות ולתיקייה
    string folderName = CategoryName.ToLower();
    
    // שליפת הנתונים ישירות מהשירות של האפליקציה שלך
    var gamePictures = PictureService.GetPictures(folderName);

    // ליתר ביטחון, אם חזר ריק, ננסה עם השם המקורי מה-URL
    if (gamePictures == null || !gamePictures.Any())
    {
        gamePictures = PictureService.GetPictures(CategoryName);
    }

    if (gamePictures != null && gamePictures.Any())
    {
        // לוקחים 6 תמונות ומערבבים
        var selectedPictures = gamePictures.OrderBy(x => Guid.NewGuid()).Take(6).ToList();
        var allCards = new List<MemoryCard>();
        
        foreach (var picUrl in selectedPictures)
        {
            // הוספת זוג קלפים לכל תמונה עם הנתיב המדויק שהשירות החזיר
            allCards.Add(new MemoryCard { Id = Guid.NewGuid(), PictureUrl = picUrl });
            allCards.Add(new MemoryCard { Id = Guid.NewGuid(), PictureUrl = picUrl });
        }

        // ערבוב סופי של הלוח
        Cards = allCards.OrderBy(a => Guid.NewGuid()).ToList();
    }
    else
    {
        // אם הגענו לכאן, השירות החזיר רשימה ריקה עבור המילה הזו
        Cards = new List<MemoryCard>();
    }

    MatchedPairs = 0;
    FlippedCards.Clear();
}

    private async Task FlipCard(MemoryCard card)
    {
        if (FlippedCards.Count < 2 && !card.IsFlipped && !card.IsMatched)
        {
            card.IsFlipped = true;
            FlippedCards.Add(card);
            StateHasChanged(); 

            if (FlippedCards.Count == 2)
            {
                await Task.Delay(1000);
                CheckForMatch();
                StateHasChanged(); 
            }
        }
    }

    private void CheckForMatch()
    {
        var card1 = FlippedCards[0];
        var card2 = FlippedCards[1];

        if (card1.PictureUrl == card2.PictureUrl)
        {
            card1.IsMatched = true;
            card2.IsMatched = true;
            MatchedPairs++;
        }
        else
        {
            card1.IsFlipped = false;
            card2.IsFlipped = false;
        }

        FlippedCards.Clear();
    }

    private void ResetGame()
    {
        InitializeGame();
    }

    public class MemoryCard
    {
        public Guid Id { get; set; }
        public string PictureUrl { get; set; }
        public bool IsFlipped { get; set; }
        public bool IsMatched { get; set; }
    }
}