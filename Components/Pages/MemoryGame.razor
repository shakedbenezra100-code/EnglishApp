@page "/memorygame/{CategoryName}"
@rendermode InteractiveServer
@inject EnglishApp.Services.PictureService PictureService

<PageTitle>Memory Game</PageTitle>

<h1 style="text-align: right; width: 100%;">משחק הזיכרון - @CategoryName</h1>

<div class="memory-game-board" style="display: flex; flex-direction: column; align-items: center; gap: 15px; margin-top: 20px;">
    @if (_cards != null && _cards.Count > 0)
    {
        var halfCount = (int)Math.Ceiling(_cards.Count / 2.0);

        <div class="card-row" style="display: flex; justify-content: center; gap: 15px;">
            @for (int i = 0; i < halfCount; i++)
            {
                var card = _cards[i];
                var cardNumber = i + 1;
                <div @key="card.Id"
                     class="memory-card"
                     @onclick="(() => FlipCard(card))"
                     style="width: 120px; height: 120px; cursor: pointer; position: relative;">
                    
                    <div class="card-inner" style="position: relative; width: 100%; height: 100%; text-align: center;">
                        @if (card.IsFlipped || card.IsMatched)
                        {
                            <!-- פנים הכרטיס - מציג את התמונה בצורה יציבה -->
                            <div class="card-front" style="position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border: 2px solid #ccc; border-radius: 8px; background-color: white;">
                                <img src="@card.PictureUrl" alt="Card Image" style="max-width: 90%; max-height: 90%; object-fit: contain;" />
                            </div>
                        }
                        else
                        {
                            <!-- גב הכרטיס - מציג את המספר -->
                            <div class="card-back" style="position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #007bff; color: white; font-size: 2rem; font-weight: bold; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                <span class="card-number">@cardNumber</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_cards.Count > halfCount)
        {
            <div class="card-row" style="display: flex; justify-content: center; gap: 15px;">
                @for (int i = halfCount; i < _cards.Count; i++)
                {
                    var card = _cards[i];
                    var cardNumber = i + 1;
                    <div @key="card.Id"
                         class="memory-card"
                         @onclick="(() => FlipCard(card))"
                         style="width: 120px; height: 120px; cursor: pointer; position: relative;">
                        
                        <div class="card-inner" style="position: relative; width: 100%; height: 100%; text-align: center;">
                            @if (card.IsFlipped || card.IsMatched)
                            {
                                <!-- פנים הכרטיס - מציג את התמונה בצורה יציבה -->
                                <div class="card-front" style="position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border: 2px solid #ccc; border-radius: 8px; background-color: white;">
                                    <img src="@card.PictureUrl" alt="Card Image" style="max-width: 90%; max-height: 90%; object-fit: contain;" />
                                </div>
                            }
                            else
                            {
                                <!-- גב הכרטיס - מציג את המספר -->
                                <div class="card-back" style="position: absolute; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #007bff; color: white; font-size: 2rem; font-weight: bold; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                                    <span class="card-number">@cardNumber</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p>Loading cards...</p>
    }
</div>

<button class="btn btn-primary mt-3" @onclick="ResetGame">Reset Memory Game</button>

@code {
    [Parameter]
    public string CategoryName { get; set; }

    private string _currentCategory;
    private List<MemoryCard> _cards;
    private MemoryCard _firstSelectedCard;
    private bool _isChecking = false;

    protected override void OnParametersSet()
    {
        // טעינת המשחק תתרחש אך ורק בעת מעבר לקטגוריה חדשה
        if (CategoryName != _currentCategory)
        {
            _currentCategory = CategoryName;
            InitializeGame();
        }
    }

    private void InitializeGame()
    {
        if (string.IsNullOrEmpty(CategoryName))
        {
            _cards = new List<MemoryCard>();
            return;
        }

        string folderName = CategoryName.ToLower();
        var gamePictures = PictureService.GetPictures(folderName);

        if (gamePictures == null || !gamePictures.Any())
        {
            gamePictures = PictureService.GetPictures(CategoryName);
        }

        if (gamePictures != null && gamePictures.Any())
        {
            var selectedPictures = gamePictures.OrderBy(x => Guid.NewGuid()).Take(6).ToList();
            var allCards = new List<MemoryCard>();
            
            foreach (var picUrl in selectedPictures)
            {
                allCards.Add(new MemoryCard { Id = Guid.NewGuid(), PictureUrl = picUrl });
                allCards.Add(new MemoryCard { Id = Guid.NewGuid(), PictureUrl = picUrl });
            }

            _cards = allCards.OrderBy(a => Guid.NewGuid()).ToList();
        }
        else
        {
            _cards = new List<MemoryCard>();
        }

        _firstSelectedCard = null;
        _isChecking = false;
    }

    private async Task FlipCard(MemoryCard card)
    {
        if (_isChecking || card.IsFlipped || card.IsMatched)
            return;

        // 1. הפיכת הכרטיס הנבחר
        card.IsFlipped = true;

        // 2. אם זה הכרטיס הראשון שנפתח בחור
        if (_firstSelectedCard == null)
        {
            _firstSelectedCard = card;
            StateHasChanged(); // מרנדר מיד כדי שהתמונה תישאר פתוחה על המסך
            return;
        }

        // 3. אם זה הכרטיס השני שנפתח
        _isChecking = true;
        StateHasChanged(); // מציג את הכרטיס השני מיד

        if (_firstSelectedCard.PictureUrl == card.PictureUrl)
        {
            // התאמה! שומרים על שניהם במצב IsMatched כדי שיישארו פתוחים
            _firstSelectedCard.IsMatched = true;
            card.IsMatched = true;
            
            _firstSelectedCard = null;
            _isChecking = false;
            StateHasChanged();
        }
        else
        {
            // אין התאמה - ממתינים שנייה אחת שיראו את התמונות ואז הופכים חזרה
            await Task.Delay(1000);

            _firstSelectedCard.IsFlipped = false;
            card.IsFlipped = false;

            _firstSelectedCard = null;
            _isChecking = false;
            StateHasChanged();
        }
    }

    private void ResetGame()
    {
        InitializeGame();
    }

    public class MemoryCard
    {
        public Guid Id { get; set; }
        public string PictureUrl { get; set; }
        public bool IsFlipped { get; set; }
        public bool IsMatched { get; set; }
    }
}