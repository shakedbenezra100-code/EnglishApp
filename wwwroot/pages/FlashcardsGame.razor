@page "/flashcards/{CategoryName}"
@using Microsoft.AspNetCore.Components.Web
@using EnglishApp.Services
@inject EnglishApp.Services.GameService GameService
<h2 class="text-center">משחק כרטיסיות - @CategoryName</h2>

@* תיקון 1: בדיקה בטוחה שהרשימה קיימת ואינה null לפני שבודקים Count *@
@if (CategoryImages != null && CategoryImages.Count > 0)
{
    <div class="d-flex flex-column align-items-center mt-4">
        <div class="card p-3 shadow" style="width: 300px; height: 300px; display: flex; justify-content: center; align-items: center;">
            <img src="@CategoryImages[currentIndex]" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
        </div>
        <div class="mt-3">
            <button class="btn btn-primary me-2" @onclick="PrevCard" disabled="@(currentIndex == 0)">הקודם</button>
            <span class="mx-2">@(currentIndex + 1) מתוך @CategoryImages.Count</span>
            <button class="btn btn-primary ms-2" @onclick="NextCard" disabled="@(currentIndex == CategoryImages.Count - 1)">הבא</button>
        </div>
    </div>
}
else
{
    <p>לא נמצאו תמונות לקטגוריה זו.</p>
}

@code {
    [Parameter] public string CategoryName { get; set; } = "";
    private List<string> CategoryImages = new();
    private int currentIndex = 0;

    protected override void OnParametersSet()
    {
        // תיקון 2: שימוש באופרטור ?? כדי להבטיח שאם יחזור null, נתחל רשימה ריקה חדשה
        CategoryImages = GameService.GetCategoryImages(CategoryName) ?? new List<string>();
        currentIndex = 0;
    }

    private void NextCard()
    {
        if (CategoryImages != null && currentIndex < CategoryImages.Count - 1) currentIndex++;
    }

    private void PrevCard()
    {
        if (currentIndex > 0) currentIndex--;
    }
}